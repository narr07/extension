{
  "manifest_version": 3,
  "name": "Input Aset KIB-E",
  "short_name": "Input KIB-E",
  "version": "1.0.0",
  "description": "Input data aset KIB-E (Aset Tetap Lainnya) di asetdisdik.id secara massal dari invoice PDF SIPLah, Excel, atau CSV.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel", "scripting"],
  "host_permissions": ["https://asetdisdik.id/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Buka panel Input KIB-E",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
